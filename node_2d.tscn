[sub_resource type="GDScript" id="GDScript_4kxuq"]
script/source = "extends Area2D

var items : Array = [\"butter\", \"egg\", \"sugar\", \"milk\", \"flour\"]
var item_order : Array = []
var items_added : int = 0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	item_order = _get_random_array(items)
	print(item_order)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func _get_random_array(array) -> Array:
	var copy = array
	var new = []
	var rng = RandomNumberGenerator.new()
	rng.seed = Time.get_unix_time_from_system()
	
	for i in range(len(array)):
		var position : int = rng.randi_range(0, len(copy) - 1)
		var value = copy[position]
		new.append(value)
		copy.pop_at(position)
	
	return new

func _on_area_entered(area: Area2D) -> void:
	var item : Node2D = area.get_parent()
	
	if item.held:
		print(item.name.to_lower())
		print(item_order[0])
		if item.name.to_lower() == item_order[0]: # If the item is equal to the first item in the list, A.K.A the next item in the sequence
			item_order.pop_front() # Advance the sequence by removing the first item.
			item.call_deferred(\"queue_free\")
			items_added += 1
			print(items_added)
			if items_added == 5:
				get_tree().call_deferred(\"reload_current_scene\")
		else:
			print(\"Nuh uh!\")
			get_tree().call_deferred(\"reload_current_scene\")
"

